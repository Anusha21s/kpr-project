# ---------------------------------------------------------------- MediCore backend
# Copy to `.env` and adjust. Never commit a real .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://medicore:change_me@127.0.0.1:5432/medicore

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# CORS — comma separated list of allowed frontend origins.
# Never "*": the API sends credentials, and a wildcard would let any site use them.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Socket.IO — the origins allowed to open a realtime connection
SOCKET_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------- HE-02 AI service
# The Python model service (FastAPI). The Node backend calls it server-to-server;
# the React app never does. When it is unreachable, every AI-backed endpoint
# degrades to deterministic operational logic instead of failing.
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TIMEOUT_MS=8000
AI_SERVICE_ADVISORY_TIMEOUT_MS=20000

# --------------------------------------------------------------- Optional
# Test database (defaults to DATABASE_URL with the database name suffixed _test)
# TEST_DATABASE_URL=postgresql://medicore:change_me@127.0.0.1:5432/medicore_test
# Seed password for the demo accounts (defaults to demo123)
# SEED_PASSWORD=demo123
