{
  "name": "medicore-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MediCore \u2014 Hospital Command Center & Resource Optimization backend (Node.js + Express + PostgreSQL + Prisma + Socket.IO)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "reset": "prisma migrate reset --force",
    "test": "node scripts/test-db.js && node --test --test-concurrency=1 tests/",
    "check": "node -e \"require('./src/app')\"",
    "test:api": "node scripts/flow-check.js",
    "db:test": "node scripts/test-db.js",
    "ai": "python3 -m ai.service.app",
    "ai:demo": "node scripts/ai-flow-check.js",
    "sweep": "node scripts/route-sweep.js",
    "flow": "node scripts/flow-check.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
