# MediCore frontend — example configuration
#
# Copy to `.env` and adjust. `VITE_API_BASE_URL` must include the /api prefix.
#
# Direct mode — the browser calls the backend directly (default ports):
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
#
# Same-origin mode — use these values when the frontend is served from a host
# that cannot reach the backend's localhost (for example a hosted preview). The
# Vite dev server then proxies /api and /socket.io to http://127.0.0.1:4000:
# VITE_API_BASE_URL=/api
# VITE_SOCKET_URL=/
#
# If the backend runs somewhere else, point MEDICORE_BACKEND_URL at it when
# starting the dev server: `MEDICORE_BACKEND_URL=https://api.example.org npm run dev`
